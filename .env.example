# ---- Robinhood credentials (never commit the real .env file) ----
RH_USERNAME=your_email@example.com
RH_PASSWORD=your_password
# Optional: base32 TOTP secret used to auto-generate MFA codes with pyotp.
# Leave blank if your account does not use app-based 2FA.
RH_TOTP_SECRET=

# ---- Safety switch ----
# The bot refuses to place live orders unless this is exactly "true".
# Keep it unset/false while testing so all orders are simulated (dry run).
CONFIRM_LIVE_TRADING=false

# ---- Watchlist ----
WATCHLIST=AAPL,MSFT,NVDA,AMD,TSLA

# ---- Technical indicator parameters ----
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
SMA_SHORT=20
SMA_LONG=50

# ---- Risk management ----
RISK_PER_TRADE_PCT=0.01
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.06
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=0.03

# ---- Order / execution ----
ORDER_TYPE=limit
LIMIT_PRICE_SLIPPAGE_PCT=0.001

# ---- Data ----
HISTORICAL_INTERVAL=day
HISTORICAL_SPAN=year

# ---- Loop timing ----
POLL_INTERVAL_SECONDS=300

# ---- Logging ----
LOG_DIR=logs
