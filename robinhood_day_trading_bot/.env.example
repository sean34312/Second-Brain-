# Copy this file to .env and fill in your own values. Never commit .env.
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password
# Robinhood requires 2FA for automated logins on most accounts. If you use an
# authenticator app, generate the current 6-digit code and put it here before
# each run, or wire up your own TOTP generator in bot/auth.py.
ROBINHOOD_MFA_CODE=

# Safety switch. The bot refuses to place *real* orders unless this is
# explicitly set to "false". Leave it "true" until you have watched a full
# session in dry-run and are comfortable with the logs it produces.
PAPER_TRADING=true
