# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- Robinhood (required for live mode; optional for paper mode = real-time quotes)
ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=your-password
# Base32 secret from Robinhood's "Authenticator app" 2FA setup (the text code shown
# under the QR code). Lets the bot generate MFA codes itself. Leave empty to be
# prompted for SMS/app approval on first login.
ROBINHOOD_MFA_SECRET=

# --- Optional alerts: Discord or Slack incoming-webhook URL
ALERT_WEBHOOK_URL=
